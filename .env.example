# Copy this file to .env for local development and replace each value.
# Never commit real credentials or production secrets.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=boost_hub
DB_USER=boost_hub
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

CURRENCY_CODE=KES
DEFAULT_COMMISSION_RATE=0.20

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Agile Hub <no-reply@example.com>
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_LOCATION=

# Production options (set DEBUG=False and configure HTTPS before deployment).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
USE_PROXY_SSL_HEADER=True
CSRF_TRUSTED_ORIGINS=
